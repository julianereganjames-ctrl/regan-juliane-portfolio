:root {
  --bg: #080b12;
  --bg-2: #0d1320;
  --panel: rgba(17, 24, 39, 0.72);
  --panel-strong: rgba(15, 23, 42, 0.96);
  --text: #f5f7fb;
  --muted: #a6b0c1;
  --line: rgba(148, 163, 184, 0.22);
  --blue: #3b82f6;
  --blue-soft: rgba(59, 130, 246, 0.16);
  --shadow: rgba(0, 0, 0, 0.45);
}

html {
  scroll-behavior: smooth;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.15), transparent 30%),
    linear-gradient(180deg, #080b12 0%, #0b1020 100%);
  color: var(--text);
  font-family: var(--font-dm-sans), sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

.page-shell::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 36px 36px;
  mask-image: radial-gradient(circle at center, black 35%, transparent 100%);
  pointer-events: none;
  z-index: 0;
}

.topbar,
main,
.site-footer {
  position: relative;
  z-index: 1;
}

.shell-section {
  width: min(1220px, calc(100% - 40px));
  margin: 0 auto;
}

.eyebrow {
  margin: 0 0 18px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.7);
  font-size: 12px;
  font-weight: 600;
}

h1,
h2,
h3,
.brand-mark,
.nav-cta,
.primary-button,
.secondary-button,
.service-item,
.builder-name,
.project-card-body h3,
.project-meta h3,
.timeline-card h3,
.cta-content h2,
.statement,
.hero-copy h1 {
  font-family: var(--font-syne), sans-serif;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(16px);
  background: rgba(8, 11, 18, 0.38);
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
}

.nav {
  width: min(1220px, calc(100% - 40px));
  margin: 0 auto;
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand-mark {
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  color: var(--text);
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
}

.nav-link {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  position: relative;
  transition: color 0.2s ease;
}

.nav-link::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 100%;
  height: 1px;
  background: var(--blue);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.nav-link:hover,
.nav-link:focus-visible {
  color: var(--text);
}

.nav-link:hover::after,
.nav-link:focus-visible::after {
  transform: scaleX(1);
}

.nav-cta,
.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.74rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-radius: 999px;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.nav-cta {
  padding: 0.86rem 1.25rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--line);
}

.nav-cta:hover,
.primary-button:hover,
.secondary-button:hover,
.nav-cta:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 18px 30px rgba(59, 130, 246, 0.14);
}

.hero {
  min-height: 760px;
  padding: 110px 0 80px;
  display: grid;
  grid-template-columns: 1.06fr 1fr;
  align-items: center;
  gap: 48px;
}

.hero-copy {
  position: relative;
  z-index: 2;
}

.hero-copy .eyebrow {
  margin-bottom: 24px;
}

.hero-copy h1 {
  margin: 0;
  display: flex;
  flex-direction: column;
  font-size: clamp(4.1rem, 7vw, 8rem);
  line-height: 0.88;
  letter-spacing: -0.065em;
  text-transform: uppercase;
}

.hero-copy h1 span {
  display: block;
}

.lede {
  margin: 28px 0 0;
  max-width: 620px;
  font-size: 1.08rem;
  line-height: 1.75;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 36px;
}

.primary-button,
.secondary-button {
  padding: 1.1rem 1.7rem;
}

.primary-button {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.9), rgba(96, 165, 250, 0.82));
  color: white;
  border: 1px solid rgba(96, 165, 250, 0.46);
  box-shadow: 0 18px 38px rgba(59, 130, 246, 0.3);
}

.secondary-button {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.22);
  color: var(--text);
}

.hero-visual {
  position: relative;
  height: 680px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.browser-window,
.project-window,
.showcase-browser,
.desktop-device,
.tablet-device,
.mobile-device {
  background: rgba(12, 16, 25, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.18);
  box-shadow: 0 34px 80px rgba(1, 3, 7, 0.58);
}

.browser-window {
  width: min(100%, 580px);
  border-radius: 26px;
  padding: 18px 18px 14px;
  position: relative;
}

.browser-topbar,
.device-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 0 16px;
}

.browser-topbar span,
.device-bar span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.26);
}

.browser-content {
  background: rgba(13, 18, 30, 0.9);
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  overflow: hidden;
  height: 490px;
  display: grid;
  grid-template-columns: 180px 1fr;
}

.browser-sidebar {
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: rgba(10, 17, 27, 0.8);
  border-right: 1px solid rgba(148, 163, 184, 0.08);
}

.sidebar-pill {
  display: flex;
  align-items: center;
  min-height: 36px;
  padding: 0 12px;
  border-radius: 10px;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid transparent;
  font-size: 0.72rem;
}

.sidebar-pill.active {
  border-color: rgba(59, 130, 246, 0.35);
  background: rgba(59, 130, 246, 0.1);
  color: var(--text);
}

.browser-main {
  padding: 20px 16px 16px;
}

.visual-header {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 18px;
}

.line {
  height: 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
}

.line.short { width: 120px; }
.line.medium { width: 180px; }

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 18px;
}

.mini-card {
  min-height: 110px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(15, 23, 42, 0.4));
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.card-b {
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.18), rgba(148, 163, 184, 0.14));
}

.content-blocks {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.block {
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(148, 163, 184, 0.09);
}

.block.large { height: 120px; }
.block.medium { height: 80px; }
.block.small { height: 46px; width: 70%; }

.floating-panel {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 150px;
  padding: 14px 16px;
  background: rgba(9, 14, 22, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 18px;
  backdrop-filter: blur(10px);
  box-shadow: 0 30px 46px rgba(2, 5, 7, 0.35);
}

.floating-panel span {
  color: rgba(255, 255, 255, 0.66);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.floating-panel strong {
  font-family: var(--font-syne), sans-serif;
  font-size: 1.2rem;
}

.panel-one { top: 80px; left: -24px; }
.panel-two { right: -10px; top: 180px; }
.panel-three { left: 40px; bottom: 40px; }

.intro {
  padding: 60px 0 20px;
}

.statement {
  margin: 0;
  display: flex;
  flex-direction: column;
  font-size: clamp(2.3rem, 5vw, 5rem);
  line-height: 0.92;
  letter-spacing: -0.06em;
  text-transform: uppercase;
}

.statement span {
  color: rgba(255, 255, 255, 0.9);
}

.about,
.expertise,
.wordpress,
.platforms,
.responsive-demo,
.portfolio,
.website-showcase,
.experience,
.toolkit,
.why,
.testimonials,
.final-cta,
.contact {
  padding: 120px 0 20px;
}

.section-heading {
  margin-bottom: 44px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(2.2rem, 4vw, 4rem);
  line-height: 0.98;
  letter-spacing: -0.06em;
  text-transform: uppercase;
}

.section-heading h2 span {
  display: block;
}

.about-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 44px;
  align-items: center;
}

.portrait-panel {
  display: flex;
  justify-content: center;
}

.portrait-figure {
  position: relative;
  width: min(100%, 480px);
  aspect-ratio: 0.9;
  border-radius: 30px;
  background: linear-gradient(135deg, rgba(17, 24, 39, 0.82), rgba(59, 130, 246, 0.08));
  border: 1px solid rgba(148, 163, 184, 0.12);
  overflow: hidden;
  box-shadow: 0 34px 64px rgba(0, 0, 0, 0.26);
}

.portrait-glow {
  position: absolute;
  inset: 10% 15% 18% 12%;
  border-radius: 24px;
  background: radial-gradient(circle at 30% 30%, rgba(96, 165, 250, 0.38), transparent 40%),
    linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(15, 23, 42, 0.16));
}

.portrait-abstract {
  position: absolute;
  inset: 18% 18% 0 18%;
  border-radius: 56% 44% 38% 62% / 48% 62% 38% 52%;
  background: linear-gradient(180deg, rgba(255,255,255,0.15), rgba(15,23,42,0.9));
  border: 1px solid rgba(255,255,255,0.1);
  transform: rotate(-10deg);
}

.about-copy p {
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 1.04rem;
  line-height: 1.9;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
}

.stats-row div {
  padding: 20px 18px;
  background: rgba(15, 23, 42, 0.58);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 18px;
}

.stats-row strong {
  display: block;
  font-size: 1.4rem;
  margin-bottom: 8px;
}

.stats-row span {
  color: rgba(255, 255, 255, 0.66);
}

.expertise-layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 32px;
  align-items: start;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.service-item,
.builder-name {
  appearance: none;
  width: 100%;
  background: rgba(15, 23, 42, 0.42);
  border: 1px solid rgba(148, 163, 184, 0.14);
  color: rgba(255, 255, 255, 0.82);
  text-align: left;
  padding: 22px 20px;
  border-radius: 18px;
  cursor: pointer;
  transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  font-size: clamp(1.05rem, 1.8vw, 1.5rem);
  line-height: 1.2;
}

.service-item.active,
.builder-name.active {
  border-color: rgba(59, 130, 246, 0.4);
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.14), rgba(15, 23, 42, 0.4));
  transform: translateX(8px);
}

.service-detail {
  min-height: 320px;
  padding: 26px 28px;
  border-radius: 24px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  background: linear-gradient(180deg, rgba(12, 18, 30, 0.8), rgba(15, 23, 42, 0.68));
  box-shadow: 0 28px 40px rgba(0, 0, 0, 0.15);
}

.service-index {
  color: rgba(96, 165, 250, 0.72);
  letter-spacing: 0.15em;
  font-size: 0.7rem;
  margin-bottom: 12px;
}

.service-detail h3 {
  margin: 0 0 18px;
  font-size: clamp(2rem, 3vw, 3rem);
  letter-spacing: -0.05em;
}

.service-detail p {
  margin: 0;
  color: var(--muted);
  font-size: 1.1rem;
  line-height: 1.9;
  max-width: 620px;
}

.wordpress-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 32px;
  align-items: center;
}

.builder-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.builder-preview {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 26px;
  align-items: center;
  padding: 24px;
  border-radius: 28px;
  background: rgba(12, 18, 30, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.builder-frame {
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 22px;
  overflow: hidden;
  background: #0f172a;
}

.builder-head {
  height: 42px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.08);
  background: rgba(255,255,255,0.02);
}

.builder-head span {
  width: 9px;
  height: 9px;
  background: rgba(255,255,255,0.28);
  border-radius: 50%;
}

.builder-body {
  display: grid;
  grid-template-columns: 112px 1fr;
  min-height: 220px;
}

.builder-sidebar {
  background: rgba(255,255,255,0.03);
  border-right: 1px solid rgba(148, 163, 184, 0.08);
}

.builder-content {
  padding: 18px;
}

.builder-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.builder-card {
  min-height: 92px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.18), rgba(148, 163, 184, 0.1));
  border: 1px solid rgba(148, 163, 184, 0.08);
}

.builder-card.big {
  grid-column: span 2;
  min-height: 124px;
}

.builder-info {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.builder-badge {
  width: fit-content;
  padding: 0.56rem 0.9rem;
  border-radius: 999px;
  border: 1px solid rgba(96, 165, 250, 0.32);
  background: rgba(59,130,246,0.08);
  color: rgba(255,255,255,0.85);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-size: 0.64rem;
}

.builder-info p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.platform-marquee {
  overflow: hidden;
  border-top: 1px solid rgba(148,163,184,0.1);
  border-bottom: 1px solid rgba(148,163,184,0.1);
  padding: 16px 0;
}

.platform-track {
  display: flex;
  gap: 24px;
  width: max-content;
  white-space: nowrap;
  animation: slide 24s linear infinite;
}

.platform-chip {
  font-size: clamp(1.4rem, 2vw, 2.2rem);
  letter-spacing: -0.05em;
  color: rgba(255,255,255,0.72);
  font-family: var(--font-syne), sans-serif;
}

@keyframes slide {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.device-stage {
  position: relative;
  display: flex;
  align-items: end;
  justify-content: center;
  min-height: 420px;
  gap: 24px;
}

.desktop-device {
  width: 560px;
  height: 330px;
  border-radius: 22px;
  padding: 16px;
}

.tablet-device {
  width: 280px;
  height: 240px;
  border-radius: 18px;
  padding: 12px;
  transform: translateY(48px);
}

.mobile-device {
  width: 150px;
  height: 280px;
  border-radius: 24px;
  padding: 12px;
  transform: translateY(72px);
}

.device-content {
  height: calc(100% - 40px);
  border: 1px solid rgba(148,163,184,0.08);
  border-radius: 16px;
  background: rgba(255,255,255,0.02);
}

.device-nav {
  height: 52px;
  border-bottom: 1px solid rgba(148,163,184,0.08);
  background: rgba(59,130,246,0.08);
}

.device-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr 0.8fr;
  gap: 12px;
  padding: 14px;
  height: calc(100% - 52px);
}

.device-feature {
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(59,130,246,0.18), rgba(148,163,184,0.08));
}

.device-feature.large {
  grid-row: span 2;
}

.featured-project {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 28px;
  align-items: center;
  margin-bottom: 38px;
}

.project-visual {
  position: relative;
}

.project-window {
  border-radius: 26px;
  padding: 18px;
}

.large-view {
  min-height: 440px;
  background: rgba(12, 18, 30, 0.92);
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid rgba(148,163,184,0.08);
  padding: 18px;
}

.feature-header {
  width: 120px;
  height: 18px;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  margin-bottom: 16px;
}

.feature-body {
  display: grid;
  grid-template-columns: 1.2fr 0.6fr;
  gap: 14px;
  height: calc(100% - 34px);
}

.feature-panel {
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(59,130,246,0.2), rgba(148,163,184,0.08));
  border: 1px solid rgba(148,163,184,0.08);
}

.feature-panel.side { background: linear-gradient(135deg, rgba(15,23,42,0.7), rgba(59,130,246,0.14)); }

.project-meta {
  padding: 18px 0;
}

.project-kicker {
  margin: 0 0 12px;
  color: rgba(96, 165, 250, 0.86);
  letter-spacing: 0.1em;
  font-size: 0.7rem;
  text-transform: uppercase;
}

.project-meta h3 {
  margin: 0 0 8px;
  font-size: clamp(2.2rem, 4vw, 4rem);
  letter-spacing: -0.06em;
}

.project-meta a {
  display: inline-block;
  margin-bottom: 14px;
  color: rgba(255,255,255,0.8);
  text-decoration: underline;
  text-underline-offset: 0.3em;
}

.project-meta p {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.project-gallery {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}

.project-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: rgba(10, 14, 22, 0.46);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 20px;
  padding: 12px;
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.project-card:hover {
  transform: translateY(-6px);
  border-color: rgba(59,130,246,0.35);
}

.project-card-visual {
  position: relative;
  min-height: 200px;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08);
}

.project-mini-browser {
  position: absolute;
  inset: 18px 18px 16px;
  background: rgba(6, 10, 18, 0.64);
  border: 1px solid rgba(148,163,184,0.08);
  border-radius: 16px;
  padding: 12px 12px 10px;
}

.mini-browser-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
}

.mini-browser-line {
  height: 12px;
  width: 80%;
  border-radius: 999px;
  background: rgba(255,255,255,0.12);
}

.mini-browser-line.medium { width: 100%; }
.mini-browser-line.short { width: 44%; }

.project-card-body {
  display: flex;
  justify-content: space-between;
  gap: 18px;
}

.project-number {
  color: rgba(96,165,250,0.8);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  padding-top: 8px;
}

.project-card-body h3 {
  margin: 0 0 4px;
  font-size: 1.25rem;
  letter-spacing: -0.04em;
}

.project-card-body p {
  margin: 0;
  color: rgba(255,255,255,0.6);
  font-size: 0.74rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.project-card-body a {
  align-self: flex-end;
  color: rgba(255,255,255,0.9);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.showcase-viewport {
  display: flex;
  justify-content: center;
  padding: 12px 0 0;
}

.showcase-browser {
  width: min(100%, 980px);
  border-radius: 30px;
  padding: 18px;
}

.showcase-body {
  min-height: 420px;
  background: rgba(10, 15, 24, 0.9);
  border: 1px solid rgba(148,163,184,0.08);
  border-radius: 20px;
  padding: 18px;
}

.showcase-nav {
  height: 44px;
  border-radius: 12px;
  background: rgba(59,130,246,0.08);
  border: 1px solid rgba(148,163,184,0.08);
  margin-bottom: 18px;
}

.showcase-content-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr 0.8fr;
  gap: 16px;
  min-height: 260px;
  margin-bottom: 18px;
}

.showcase-card {
  border-radius: 22px;
  border: 1px solid rgba(148,163,184,0.08);
  background: linear-gradient(135deg, rgba(59,130,246,0.18), rgba(15,23,42,0.64));
}

.card-one { min-height: 220px; }
.card-two { min-height: 180px; }
.card-three { min-height: 140px; }

.showcase-footer {
  height: 90px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(59,130,246,0.08));
  border: 1px solid rgba(148,163,184,0.08);
}

.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28px;
  padding-left: 32px;
}

.timeline-line {
  position: absolute;
  left: 8px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, rgba(59,130,246,0.2), rgba(59,130,246,0.9), rgba(59,130,246,0.2));
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 24px 1fr;
  gap: 18px;
  align-items: start;
}

.timeline-dot {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(59,130,246,0.9);
  box-shadow: 0 0 0 7px rgba(59,130,246,0.12);
  margin-top: 10px;
}

.timeline-card {
  padding: 24px 26px;
  border-radius: 20px;
  border: 1px solid rgba(148,163,184,0.12);
  background: rgba(15, 23, 42, 0.56);
}

.timeline-meta {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
  color: rgba(255,255,255,0.7);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.timeline-card h3 {
  margin: 0 0 16px;
  font-size: clamp(1.7rem, 2vw, 2.3rem);
  letter-spacing: -0.06em;
}

.timeline-card ul {
  margin: 0;
  padding-left: 18px;
  color: var(--muted);
  line-height: 1.9;
}

.tool-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.tool-pill {
  display: inline-flex;
  align-items: center;
  padding: 0.75rem 1rem;
  border-radius: 999px;
  border: 1px solid rgba(148,163,184,0.12);
  background: rgba(15, 23, 42, 0.5);
  color: rgba(255,255,255,0.82);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.tool-pill:hover {
  transform: translateY(-2px);
  border-color: rgba(59,130,246,0.4);
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.why-card {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 22px 20px;
  border-radius: 22px;
  border: 1px solid rgba(148,163,184,0.12);
  background: linear-gradient(180deg, rgba(15,23,42,0.76), rgba(10,15,24,0.84));
}

.why-number {
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  color: rgba(96,165,250,0.82);
}

.why-card p {
  margin: 0;
  font-size: 1.1rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.85);
}

.testimonial-slider {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 20px;
  align-items: center;
}

.testimonial-card {
  background: rgba(13, 18, 30, 0.88);
  border: 1px solid rgba(148,163,184,0.12);
  border-radius: 26px;
  padding: 32px 24px;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.testimonial-card p {
  margin: 0;
  font-size: clamp(1.5rem, 2.5vw, 2.3rem);
  line-height: 1.2;
  letter-spacing: -0.04em;
  font-family: var(--font-syne), sans-serif;
}

.testimonial-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 20px;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-size: 0.7rem;
}

.testimonial-controls {
  display: flex;
  gap: 12px;
}

.testimonial-controls button {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid rgba(148,163,184,0.16);
  background: rgba(15,23,42,0.7);
  color: var(--text);
  font-size: 1.25rem;
  cursor: pointer;
}

.final-cta {
  padding-top: 100px;
}

.cta-content {
  position: relative;
  overflow: hidden;
  padding: 54px 26px 42px;
  border-radius: 32px;
  background: radial-gradient(circle at 15% 15%, rgba(59,130,246,0.2), transparent 30%),
    linear-gradient(160deg, rgba(10,15,24,0.92), rgba(17,24,39,0.82));
  border: 1px solid rgba(148,163,184,0.12);
}

.cta-content .eyebrow {
  margin-bottom: 20px;
}

.cta-content h2 {
  margin: 0 0 26px;
  font-size: clamp(3rem, 6vw, 7rem);
  line-height: 0.9;
  letter-spacing: -0.07em;
  text-transform: uppercase;
}

.cta-content h2 span {
  display: block;
}

.large-button {
  padding: 1.2rem 2rem;
}

.contact-grid {
  display: grid;
  grid-template-columns: 0.6fr 1.3fr;
  gap: 26px;
  align-items: start;
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 32px;
  padding: 32px 24px;
  border-radius: 22px;
  background: rgba(13,18,30,0.8);
  border: 1px solid rgba(148,163,184,0.12);
}

.contact-details div {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.contact-details span {
  color: rgba(255,255,255,0.66);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-size: 0.66rem;
}

.contact-details a {
  font-size: 1.1rem;
  color: var(--text);
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 28px 24px;
  border-radius: 22px;
  background: rgba(13,18,30,0.8);
  border: 1px solid rgba(148,163,184,0.12);
}

.field-row {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.two-up {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.contact-form label {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 0.74rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid rgba(148,163,184,0.14);
  background: rgba(255,255,255,0.02);
  border-radius: 14px;
  color: var(--text);
  padding: 1rem 1.05rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: rgba(59,130,246,0.6);
  box-shadow: 0 0 0 3px rgba(59,130,246,0.14);
}

.site-footer {
  width: min(1220px, calc(100% - 40px));
  margin: 0 auto;
  padding: 32px 0 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid rgba(148,163,184,0.12);
}

.footer-brand-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer-brand-group p {
  margin: 0;
  color: var(--muted);
}

.footer-links,
.footer-meta {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.footer-links a,
.footer-meta a {
  color: rgba(255,255,255,0.84);
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.back-to-top {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid rgba(148,163,184,0.14);
  background: rgba(15,23,42,0.7);
  color: var(--text);
  cursor: pointer;
}

.preloader {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  background: #080b12;
  z-index: 100;
}

.preloader-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.preloader-word {
  font-family: var(--font-syne), sans-serif;
  font-size: clamp(2.2rem, 5vw, 5rem);
  letter-spacing: -0.06em;
  text-transform: uppercase;
  line-height: 0.9;
}

.preloader-bar {
  width: min(340px, 65vw);
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, rgba(59,130,246,0.8) 20%, rgba(96,165,250,0.9) 50%, transparent 100%);
  transform-origin: left center;
}

.custom-cursor {
  position: fixed;
  left: 0;
  top: 0;
  pointer-events: none;
  z-index: 60;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.18);
  background: rgba(59,130,246,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.85);
  font-size: 0.56rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  opacity: 0;
  transform: translate(-50%, -50%);
  transition: opacity 0.2s ease;
}

.custom-cursor span {
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

body:hover .custom-cursor,
body:focus-within .custom-cursor {
  opacity: 1;
}

body:hover .custom-cursor span,
body:focus-within .custom-cursor span {
  opacity: 1;
  transform: scale(1);
}

@media (max-width: 1100px) {
  .hero,
  .about-grid,
  .expertise-layout,
  .wordpress-layout,
  .featured-project,
  .contact-grid,
  .project-gallery {
    grid-template-columns: 1fr;
  }

  .project-gallery {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero {
    padding-top: 90px;
  }

  .nav-links {
    display: none;
  }
}

@media (max-width: 780px) {
  .shell-section {
    width: min(100% - 24px, 1220px);
  }

  .nav {
    width: min(100% - 24px, 1220px);
    min-height: 72px;
  }

  .brand-mark {
    font-size: 0.69rem;
    letter-spacing: 0.08em;
  }

  .nav-cta {
    display: none;
  }

  .hero {
    min-height: 660px;
    padding-top: 70px;
  }

  .hero-copy h1 {
    font-size: clamp(3.2rem, 16vw, 6rem);
  }

  .statement {
    font-size: clamp(2rem, 11vw, 4rem);
  }

  .browser-content {
    grid-template-columns: 1fr;
  }

  .browser-sidebar {
    display: none;
  }

  .panel-one,
  .panel-two,
  .panel-three {
    display: none;
  }

  .two-up,
  .stats-row,
  .why-grid,
  .project-gallery {
    grid-template-columns: 1fr;
  }

  .device-stage {
    flex-direction: column;
    align-items: center;
    min-height: 600px;
  }

  .desktop-device {
    width: 100%;
    max-width: 460px;
  }

  .tablet-device,
  .mobile-device {
    transform: none;
  }

  .timeline {
    padding-left: 20px;
  }

  .timeline-meta {
    flex-direction: column;
  }

  .site-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .custom-cursor {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
